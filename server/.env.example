PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/pizza-delivery
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173

# Razorpay test mode credentials from your Razorpay dashboard
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-key-secret

# Gmail SMTP app password (or adapt mailer.js to your SMTP provider)
EMAIL_USER=replace-with-sender@gmail.com
EMAIL_APP_PASSWORD=replace-with-gmail-app-password
EMAIL_FROM=PizzaGo <replace-with-sender@gmail.com>
LOW_STOCK_ALERT_EMAIL=replace-with-admin-email@example.com
LOW_STOCK_CHECK_INTERVAL_MINUTES=5
